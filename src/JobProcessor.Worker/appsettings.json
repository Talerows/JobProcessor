      "JobProcessor": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        //"IncludeScopes": true,
        //"TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  }
